{
  "name": "vio-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run --filter \"./packages/*\" build",
    "test": "vp run --filter \"./packages/*\" test",
    "typecheck": "vp run --filter \"./packages/*\" typecheck",
    "architecture": "node scripts/check-feod.mjs",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "check": "vp run architecture && vp fmt --check && vp run build && vp run typecheck && vp run test && vp run test:package",
    "test:gtk": "vp run --filter \"./packages/*\" test:gtk",
    "test:package": "node scripts/test-package.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@o-feod/oxlint-structure-plugin": "0.1.3",
    "oxlint": "^1.86.0",
    "vite-plus": "0.3.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.6.0"
}
